# Base URL of eduteach-textbook-api (catalog: books/chapters/content)
CATALOG_API_BASE=https://eduteach-textbook-api.onrender.com

# Base URL of textbook-retrieval (semantic search over indexed books)
RETRIEVAL_API_BASE=https://text-book-rag.onrender.com

# Base URL of eduteach-simulation-host (stores generated HTML simulations)
SIMULATION_HOST_BASE=https://eduteach-simulation-host.onrender.com

# Timeout for upstream calls -- both are free-tier Render services that
# cold-start slowly after inactivity.
HTTP_TIMEOUT_SECONDS=60

# Longer timeout specifically for create_prep_sheet -- it launches a headless
# browser and renders a PDF server-side, on top of any cold-start delay.
PREP_SHEET_TIMEOUT_SECONDS=60

# Port the MCP server binds to (Render sets $PORT at runtime)
PORT=8000
